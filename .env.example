# ============================================================
# My CLI — Root Environment Configuration
# ============================================================
# This file is read by docker-compose.yml and injected into
# containers. Copy to .env and fill in the required values.
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=yu
POSTGRES_PASSWORD=password
POSTGRES_DB=my-cli-db

# --- PgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=password

# --- Laravel App Key ---
# Generate with: docker exec my-cli-api php artisan key:generate --force --show
# Then paste the output here and run: docker compose up -d api
APP_KEY=

# --- Database Host (container name) ---
DB_HOST=db

# --- Cloudflare Tunnel (public HTTPS access) ---
# Leave blank to disable tunnel
CLOUDFLARED_TOKEN=

# --- Google Cloud API Key ---
# Required for: Translate MOD (Google provider), Speech-to-Text MOD
GG_API=

# --- Ollama (self-hosted LLM, optional) ---
# Only used with: docker compose --profile mods up -d
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# --- Mail Configuration ---
# Default: Mailpit (local testing, no real emails sent)
# Switch to Google SMTP for production email delivery
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=admin@my-cli.local
MAIL_FROM_NAME=MyCLI_System

# --- Google SMTP example (uncomment to use) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=your-email@gmail.com
